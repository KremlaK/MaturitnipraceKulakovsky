# Zkopíruj jako backend/.env a vyplň. Soubor .env nikdy nedávej do gitu.

# development | production (v produkci server kontroluje přísnější pravidla)
NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/autoapp

# Náhodný klíč aspoň 32 znaků. Vygeneruj:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Když ho změníš, všichni uživatelé se musí znovu přihlásit.
JWT_SECRET=

# Adresa frontendu (CORS a odkazy v e-mailech). Víc adres odděl čárkou.
# V produkci musí začínat https://
FRONTEND_URL=http://localhost:5173

# Za Apachem / nginx nastav 1, aby omezení pokusů vidělo skutečné IP uživatelů
TRUST_PROXY=

# E-maily (ověření, obnova hesla, připomínky) přes Resend.
# Bez klíče se při vývoji e-maily jen vypíšou do konzole serveru.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Kam posílat upozornění na nová hlášení chyb (nepovinné)
ADMIN_EMAIL=

# Nahrávání fotek a faktur (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Kontakt pro vyhledávání míst přes OpenStreetMap Nominatim (jejich pravidla ho vyžadují)
NOMINATIM_CONTACT=
