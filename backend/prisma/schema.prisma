// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password              String
  name                  String?
  emailVerified         Boolean   @default(false)
  emailVerifyToken      String?
  emailVerifyExpires    DateTime?
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  cars                  Car[]
}

model Car {
  id           String   @id @default(uuid())
  vin          String?  @unique
  licensePlate String?
  make         String
  model        String
  year         Int?
  mileage      Int?     @default(0)
  notes        String?
  photoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  serviceRecords ServiceRecord[]
  fuelRecords    FuelRecord[]
  expenses       Expense[]
  reminders      Reminder[]
  photos         Photo[]
}

model ServiceRecord {
  id          String   @id @default(uuid())
  type        String
  description String?
  price       Float?
  date        DateTime
  mileage     Int?
  invoiceUrl  String?
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  carId       String
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model FuelRecord {
  id             String   @id @default(uuid())
  date           DateTime
  liters         Float
  pricePerLiter  Float
  totalPrice     Float
  mileage        Int
  fuelType       String
  fullTank       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  carId          String
  car            Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

enum ExpenseCategory {
  PNEUMATIKY
  POJISTENI
  STK
  PARKOVANI
  DALNICNI_ZNAMKA
  TUNING
  MYCKA
  OSTATNI
}

model Expense {
  id          String          @id @default(uuid())
  category    ExpenseCategory
  description String?
  price       Float
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  carId       String
  car         Car             @relation(fields: [carId], references: [id], onDelete: Cascade)
}

enum ReminderType {
  VYMENA_OLEJE
  STK
  EMISE
  POJISTENI
  VYMENA_PNEUMATIK
  VLASTNI
}

model Reminder {
  id            String       @id @default(uuid())
  type          ReminderType
  title         String
  notes         String?
  dueDate       DateTime?
  dueMileage    Int?
  emailAlert    Boolean      @default(true)
  completed     Boolean      @default(false)
  notifiedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  carId         String
  car           Car          @relation(fields: [carId], references: [id], onDelete: Cascade)
}

enum PhotoCategory {
  AUTO
  OPRAVA
  TUNING
  OSTATNI
}

model Photo {
  id        String        @id @default(uuid())
  url       String
  category  PhotoCategory @default(AUTO)
  caption   String?
  createdAt DateTime      @default(now())

  carId     String
  car       Car           @relation(fields: [carId], references: [id], onDelete: Cascade)
}