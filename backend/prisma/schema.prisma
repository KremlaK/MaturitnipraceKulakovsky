// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  password             String
  name                 String?
  emailVerified        Boolean           @default(false)
  emailVerifyToken     String?
  emailVerifyExpires   DateTime?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  // zvýší se při změně hesla – tím přestanou platit všechna dříve vydaná přihlášení
  tokenVersion         Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  cars                 Car[]
  carShares            CarShare[]
  favoriteStations     FavoriteStation[]
  bugReports           BugReport[]
  review               Review?
}

model Car {
  id             String        @id @default(uuid())
  vin            String?       @unique
  licensePlate   String?
  make           String
  model          String
  year           Int?
  mileage        Int?          @default(0)
  bodyType       BodyType?
  photoView      CarPhotoView?
  // fotka auta s odstraněným pozadím (vystřižené auto pro garáž)
  photoCutoutUrl String?
  notes          String?
  photoUrl       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  serviceRecords ServiceRecord[]
  fuelRecords    FuelRecord[]
  expenses       Expense[]
  reminders      Reminder[]
  photos         Photo[]
  shares         CarShare[]
}

model ServiceRecord {
  id          String   @id @default(uuid())
  type        String
  description String?
  price       Float?
  date        DateTime
  mileage     Int?
  invoiceUrl  String?
  photoUrl    String?
  latitude    Float?
  longitude   Float?
  placeName   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model FuelRecord {
  id            String   @id @default(uuid())
  date          DateTime
  liters        Float
  pricePerLiter Float
  totalPrice    Float
  mileage       Int
  fuelType      String
  fullTank      Boolean  @default(true)
  latitude      Float?
  longitude     Float?
  placeName     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
}

enum ExpenseCategory {
  PNEUMATIKY
  POJISTENI
  STK
  PARKOVANI
  DALNICNI_ZNAMKA
  TUNING
  MYCKA
  OSTATNI
}

model Expense {
  id          String          @id @default(uuid())
  category    ExpenseCategory
  description String?
  price       Float
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
}

enum ReminderType {
  VYMENA_OLEJE
  STK
  EMISE
  POJISTENI
  VYMENA_PNEUMATIK
  VLASTNI
}

model Reminder {
  id         String       @id @default(uuid())
  type       ReminderType
  title      String
  notes      String?
  dueDate    DateTime?
  dueMileage Int?
  emailAlert Boolean      @default(true)
  completed  Boolean      @default(false)
  notifiedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
}

enum PhotoCategory {
  AUTO
  OPRAVA
  TUNING
  OSTATNI
}

model Photo {
  id        String        @id @default(uuid())
  url       String
  category  PhotoCategory @default(AUTO)
  caption   String?
  createdAt DateTime      @default(now())

  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
}

enum ShareRole {
  SPOLUMAJITEL
  SERVIS
}

model CarShare {
  id        String    @id @default(uuid())
  role      ShareRole @default(SPOLUMAJITEL)
  createdAt DateTime  @default(now())

  carId  String
  car    Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([carId, userId])
}

// Typ karoserie – podle něj se kreslí bokorys auta na Přehledu
enum BodyType {
  HATCHBACK
  SEDAN
  KOMBI
  SUV
}

// Odkud je vyfocená hlavní fotka auta (určuje, jak se zobrazí v garáži a na přehledu)
enum CarPhotoView {
  FRONT
  SIDE
}

// Oblíbené čerpací stanice uživatele – rychlý výběr při tankování
model FavoriteStation {
  id        String   @id @default(uuid())
  name      String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

enum BugStatus {
  NEW
  SEEN
  FIXED
}

// Hlášení chyb od uživatelů
model BugReport {
  id          String    @id @default(uuid())
  title       String
  description String
  pageUrl     String?
  userAgent   String?
  status      BugStatus @default(NEW)
  createdAt   DateTime  @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Recenze aplikace – každý uživatel jednu, může ji upravit
model Review {
  id        String   @id @default(uuid())
  rating    Int
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
